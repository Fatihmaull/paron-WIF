# =====================================================================
# Paron WIF environment template. Placeholders only: never commit a populated .env.
# Every value is optional. With no .env at all the web app runs the deterministic
# local simulation and the 60-Second Coded Judge Tour works out of the box.
# =====================================================================

# ---- Target chain (Flat-World EVM chain) ----
# Chain ID of the hackathon's target EVM chain (testnet: 46630). Use 31337 for a local anvil chain.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME="Flat World EVM / Target Chain"
# Public RPC endpoint of the target chain, from the organizer's network docs. Never paste a keyed URL here.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Server-side RPC for the indexer and the agent runner (may be a keyed provider URL, kept out of git).
RPC_URL=

# ---- Deployment (contracts/script/DeployParonWif.s.sol) ----
# Hex private key of a funded testnet deployer. Leave empty in this file.
PARON_DEPLOYER_PK=
# Point the protocol at the canonical $WIF / USDG contracts instead of deploying mocks.
WIF_TOKEN_ADDRESS=
# true when $WIF exposes burn()/burnFrom(); false burns to 0x000000000000000000000000000000000000dEaD
WIF_NATIVE_BURN=
USDG_TOKEN_ADDRESS=
TREASURY_ADDRESS=
# Comma-separated CRI-H100 attestor addresses (default: the deployer) and the quorum required to publish.
INDEX_ATTESTORS=
CRI_QUORUM=1
# Reference prices in USDG base units (6 decimals): 500 = $0.0005 per $WIF, 2200000 = $2.20 per CU
WIF_PRICE_USDG=500
CRI_H100_USDG=2200000
SEED_MARKET=true

# ---- Web app (web/) ----
# Contract addresses. Empty values are filled from deployments/<chainId>.json at build time.
NEXT_PUBLIC_ADDR_WIF=
NEXT_PUBLIC_ADDR_USDG=
NEXT_PUBLIC_ADDR_SERIES=
NEXT_PUBLIC_ADDR_VAULT=
NEXT_PUBLIC_ADDR_DESK=
NEXT_PUBLIC_ADDR_JURY=
# Optional indexer API (indexer/), e.g. http://localhost:8787
NEXT_PUBLIC_INDEXER_URL=

# ---- Indexer & API (indexer/) ----
INDEXER_PORT=8787
INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_MS=4000

# ---- Autonomous CFO compute agent (npm run agent) ----
# Hex private key of the agent wallet (testnet only). Empty = the agent runs in simulation mode.
AGENT_PRIVATE_KEY=
AGENT_MAX_PRICE_USDG=2300000
AGENT_LATENCY_SLA_MS=250
# Bounded token allowances the agent grants the desk (base units: USDG 6 decimals, $WIF 18 decimals).
AGENT_APPROVAL_USDG=10000000000
AGENT_APPROVAL_WIF=500000000000000000000000
